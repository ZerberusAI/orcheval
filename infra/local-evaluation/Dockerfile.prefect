FROM python:3.12-slim@sha256:ddb0207ae1f0356c2b724d740769b0c5f5f51cc54a0525178f721825f78fe74c

WORKDIR /opt/orcheval-prefect
ENV PIP_DISABLE_PIP_VERSION_CHECK=1 PIP_NO_CACHE_DIR=1
RUN pip install --no-cache-dir prefect==3.8.7
COPY prefect-service.py ./prefect-service.py

CMD ["python", "prefect-service.py"]
