{
  "name": "@zerberus/orcheval",
  "version": "0.1.0",
  "private": true,
  "description": "Policy-driven framework for evaluating orchestration runtimes using reproducible workloads and mandatory security gates.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "lint": "tsc -p tsconfig.json --noEmit",
    "eval:local": "node --experimental-strip-types packages/cli/index.ts run examples/orchestration-evaluation.yaml"
  },
  "engines": {
    "node": ">=22.6"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "typescript": "^7.0.2"
  }
}
